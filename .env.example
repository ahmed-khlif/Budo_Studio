PORT=8787
CORS_ORIGIN=http://localhost:5181,http://localhost:5173,http://localhost:8787

# Leave Supabase blank to use the local in-memory adapter while developing.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared workspace used by all signed-in BUDO Studio accounts.
BUDO_WORKSPACE_ID=budo-studio-shared
REQUIRE_AUTH=false
ADMIN_EMAILS=
# Optional public origin used in QR verification links. Defaults to the request origin.
PUBLIC_APP_URL=

# Required for template/image persistence. Never expose these values in the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. OCR and template brainstorming remain disabled until this is configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
